#!/bin/sh
#
# Pre-commit quality gate — the fast core subset of what CI runs, so the
# mistakes that are cheap to catch are caught before a push:
#   1. type-check with warnings treated as errors (0 warnings);
#   2. refresh formatting and the generated `.mbti` interfaces, failing if
#      either leaves changes you haven't staged (run `moon fmt && moon info`
#      and stage the result, then re-commit);
#   3. run the test suite on the default target.
#
# It is deliberately *not* the whole gate: the every-backend run, coverage,
# the benchmarks, the fuzz and parity suites, and the documentation /
# architecture guards are all too slow for every commit and run in CI instead.
# The complete list lives in `.github/workflows/ci.yml`, with what each guard
# governs in `AGENTS.md`. To skip this hook in a pinch use
# `git commit --no-verify`.
set -e

moon check --deny-warn
moon fmt
moon info
# `git diff --quiet` only inspects tracked files, so a newly added package
# whose generated `.mbti` was never staged would slip through. Treat any
# untracked generated interface as drift too, mirroring the CI gate.
untracked_mbti=$(git ls-files --others --exclude-standard -- '*.mbti')
if ! git diff --quiet || [ -n "$untracked_mbti" ]; then
  echo "pre-commit: 'moon fmt' / 'moon info' produced changes. Review and stage them, then re-commit:" >&2
  git --no-pager diff --name-only >&2
  if [ -n "$untracked_mbti" ]; then
    printf '%s\n' "$untracked_mbti" >&2
  fi
  exit 1
fi
moon test
