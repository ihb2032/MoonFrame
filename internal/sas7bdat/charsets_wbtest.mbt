///|
/// The character set of `code`, or a failure saying what came out instead.
fn charset_of_or_fail(code : Int32) -> Charset raise {
  let outcome : Result[Charset, @types.DataError] = Ok(charset_of(code)) catch {
    e => Err(e)
  }
  match outcome {
    Ok(charset) => charset
    Err(_) => fail("code \{code} is refused, though the table holds it")
  }
}

///|
/// A header whose text is in the character set of `code`, or the text of
/// why there is none.
fn charset_header(code : Int32) -> Result[Header, String] {
  let outcome : Result[Charset, @types.DataError] = Ok(charset_of(code)) catch {
    e => Err(e)
  }
  match outcome {
    Ok(Single(page)) =>
      Ok(Header::{
        wide: false,
        little: true,
        charset: Single(page),
        header_length: 1024L,
        page_length: 4096L,
        pages: 1L,
      })
    Ok(Utf8) => Err("code \{code} is UTF-8, not a table entry")
    Err(_) => Err("code \{code} is refused, though the table holds it")
  }
}

///|
/// The byte `byte` alone at file offset 1000, decoded as the header of
/// `code` says: the text, or the refusal's.
fn charset_decode(code : Int32, byte : Int32) -> Result[String, String] {
  let header = match charset_header(code) {
    Ok(header) => header
    Err(text) => return Err(text)
  }
  let outcome : Result[String, @types.DataError] = Ok(
    decode_text(Bytes::makei(1, _ => byte.to_byte()), 0L, 1L, 1000L, header),
  ) catch {
    e => Err(e)
  }
  match outcome {
    Ok(text) => Ok(text)
    Err(@types.DataError::ParseError(@types.ParseErrorDetail::Message(text))) =>
      Err(text)
    Err(_) => Err("not a ParseError")
  }
}

///|
test "every code page decodes its sampled bytes as the codecs do" {
  for (code, byte, expected) in charset_samples {
    assert_eq(charset_decode(code, byte), Ok(expected))
  }
}

///|
test "every table entry spells one unit per byte from 0x80 on" {
  for page in charset_pages {
    assert_eq(page.high.code_units().length(), 128)
  }
}

///|
test "a byte a code page leaves undefined refuses, naming the byte and the code page" {
  for (code, byte, expected) in charset_undefined_samples {
    assert_eq(charset_decode(code, byte), Err(expected))
  }
}

///|
test "every character set the table names and this reader does not decode refuses by name" {
  for (code, name) in charsets_not_decoded {
    let outcome : Result[Charset, @types.DataError] = Ok(charset_of(code)) catch {
      e => Err(e)
    }
    match outcome {
      Err(@types.DataError::Unsupported(text)) =>
        assert_eq(
          text,
          "sas7bdat: byte 70: the character-set field names \{name} (code \{code}), and this reader decodes UTF-8 (code 20) and the single-byte character sets",
        )
      _ => fail("code \{code} did not refuse")
    }
  }
  assert_eq(charset_of_or_fail(20) is Utf8, true)
  assert_eq(charset_of_or_fail(charset_pages[0].code) is Single(_), true)
  assert_eq(charset_name(250), "an unassigned code")
}
