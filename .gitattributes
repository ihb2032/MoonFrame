# All text files use LF, regardless of OS. Without this, Windows
# checkouts with `core.autocrlf=true` (Git for Windows default) flag
# every tracked source file as modified, because the working tree gets
# CRLF while the repo stores LF.
* text=auto eol=lf

# A fixture whose line endings are the thing under test keeps its bytes.
.github/fixtures/fwf/reference/crlf_line_endings.txt -text
