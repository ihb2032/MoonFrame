    "quant2|376217E-5970|1|0", "mul|17100e+3811|36714|6.27809400E+3819", "add|14.2564075|376164740594676577083957681972224e-3965|14.25640750000000000000000000000000",
    "div|8.3054|590282483210449630805062307791e-2071|1.407021254438771642268918340950579E+2042",
    "quant2|486036048067491921162e+5870|1E+1|NaN", "quant2|54578222540408241E+4625|1E+2|NaN",
    "quant2|-0933854366363|1|-933854366363",
  ]
  for v in vectors {
    let parts = split_on(v, 124)
    let a = @types.Dec128::parse_opt(python_shape(parts[1])).unwrap()
    let b = @types.Dec128::parse_opt(python_shape(parts[2])).unwrap()
    let expected_raw = parts[3]
    let got = match parts[0] {
      "add" => a.add(b)
      "sub" => a.sub(b)
      "mul" => a.mul(b)
      "div" => a.div(b)
      "quant2" => a.quantize(places=quant_places(b))
      _ => fail("an unknown golden op")
    }
    if expected_raw == "NaN" {
      if !got.is_nan() {
        fail("v=" + v + ": expected NaN, got " + got.to_string())
      }
    } else {
      let expected = @types.Dec128::parse_opt(python_shape(expected_raw)).unwrap()
      if !got.equal(expected) {
        fail(
          "v=" +
          v +
          ": got " +
          got.to_string() +
          ", want " +
          expected.to_string(),
        )
      }
    }
  }
}

///|
/// Python's exceptional spellings mapped to the render's own.
fn python_shape(s : String) -> String {
  if s == "Infinity" || s == "+Infinity" {
    "inf"
  } else if s == "-Infinity" {
    "-inf"
  } else {
    s
  }
}

///|
/// The quantize exponent a Python second operand names: 1, 1E+1,
/// 1E+2, 1E-3 are 0, -1, -2, 3 decimal places.
fn quant_places(exp_one : @types.Dec128) -> Int32 {
  let e = exp_one.exponent().unwrap()
  -e
}

///|
/// Split on a one-code-unit separator (its code, `|` = 124) — the
/// golden lines carry no separators in their fields.
fn split_on(s : String, sep : Int32) -> Array[String] {
  let cuts : Array[Int32] = []
  for i in 0..<s.length() {
    if s[i].to_int() == sep {
      cuts.push(i)
    }
  }
  let out : Array[String] = []
  let mut prev = 0
  for c in cuts {
    out.push(s[prev:c].to_owned())
    prev = c + 1
  }
  out.push(s[prev:].to_owned())
  out
}
