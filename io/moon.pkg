import {
  "ihb2032/MoonFrame/internal/avro",
  "ihb2032/MoonFrame/internal/ipc",
  "ihb2032/MoonFrame/internal/parquet",
  "ihb2032/MoonFrame/internal/orc",
  "ihb2032/MoonFrame/internal/stata",
  "ihb2032/MoonFrame/internal/sas7bdat",
  "ihb2032/MoonFrame/internal/xport",
  "ihb2032/MoonFrame/internal/spss",
  "ihb2032/MoonFrame/internal/scan",
  "ihb2032/MoonFrame/internal/numeric",
  "ihb2032/MoonFrame/frame",
  "ihb2032/MoonFrame/internal/text",
  "ihb2032/MoonFrame/series",
  "ihb2032/MoonFrame/types",
  "moonbit-community/NyaCSV" @nyacsv,
  "moonbitstack/moondb",
  "moonbitlang/mbtexcel/xlsx",
  "moonbitlang/core/compress/gzip",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf16",
  "moonbitlang/core/encoding/utf8",
  "Milky2018/xml",
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
}

import {
  "moonbitlang/core/bench",
  "moonbitlang/core/double",
  "moonbitlang/core/test",
  "moonbitlang/core/quickcheck" @gen,
  "ihb2032/MoonFrame/expr",
  "moonbitstack/moondb",
} for "test"

// `core/compress/gzip` is still marked experimental upstream; the reader's
// gzip path rides it, so the dependency is acknowledged here.

options(
  "allow-experimental-packages": [ "moonbitlang/core/compress/gzip" ],
)

// The backends the package builds for, named because a dependency of
// the module names its own and the build asks the same of what depends
// on it.

supported_targets = "js + native + wasm + wasm-gc"
