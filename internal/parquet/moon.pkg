// The codec's dependencies: the value types it maps to, the series
// constructors it builds columns through, the shared UTF-16 guard its
// string cells pass before encoding, and the byte / gzip cores its
// page work rides.
import {
  "ihb2032/MoonFrame/types",
  "ihb2032/MoonFrame/series",
  "ihb2032/MoonFrame/internal/text",
  "moonbitlang/core/compress/gzip",
  "moonbitlang/core/encoding/utf8",
}

// `core/compress/gzip` is still marked experimental upstream; the parquet
// footer's compressed pages ride it, so the dependency is acknowledged here.

options(
  "allow-experimental-packages": [ "moonbitlang/core/compress/gzip" ],
)
